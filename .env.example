APP_NAME="THT MEDIA VN"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://thtmediavn.test

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN
APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=thtmediavn
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
SETTINGS_CACHE_ENABLED=true
SETTINGS_CACHE_MEMO=true
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@thtmediavn.test"
MAIL_FROM_NAME="${APP_NAME}"
CONTACT_NOTIFICATION_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Chỉ tạo tài khoản quản trị khi cả email và mật khẩu được cấu hình.
ADMIN_NAME="Quản trị THT MEDIA VN"
ADMIN_EMAIL=
ADMIN_PASSWORD=

SHIPPING_FLAT_FEE=30000
FREE_SHIPPING_THRESHOLD=1000000

# SePay QR + HMAC webhook + API v2. Token/secret chỉ lưu ở môi trường máy chủ.
SEPAY_ENABLED=false
SEPAY_MODE=test
SEPAY_PAYMENT_TIMEOUT_MINUTES=20
SEPAY_PAYMENT_PREFIX=THT
SEPAY_BANK_NAME=
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NAME=
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK_BRANCH=
SEPAY_WEBHOOK_SECRET=
SEPAY_API_TOKEN=
# Để trống để tự chọn endpoint theo SEPAY_MODE.
SEPAY_API_BASE_URL=
SEPAY_INITIAL_RECONCILIATION_DAYS=7
SEPAY_ALLOW_UNDERPAYMENT=false
SEPAY_ALLOW_LATE_PAYMENT=false
